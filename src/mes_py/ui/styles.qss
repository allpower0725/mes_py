* {
  font-family: "Noto Sans TC", "Microsoft JhengHei", "Segoe UI", sans-serif;
  font-size: 14px;
}

QMainWindow, QDialog {
  background: #070b0d;
  color: #eef4f2;
}

QFrame#Sidebar {
  background: #080d10;
  border-right: 1px solid #1c292f;
}

QLabel#BrandTitle {
  color: #eef4f2;
  font-size: 18px;
  font-weight: 800;
}

QLabel#BrandSub, QLabel#Muted, QLabel#Eyebrow {
  color: #829098;
}

QLabel#Eyebrow {
  color: #12d69a;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 1px;
}

QLabel#PageTitle {
  color: #eef4f2;
  font-size: 21px;
  font-weight: 800;
}

QLabel#SectionTitle {
  color: #eef4f2;
  font-size: 24px;
  font-weight: 900;
}

QLabel#FieldLabel {
  color: #95a5a0;
  font-size: 13px;
  font-weight: 800;
}

QFrame#Topbar {
  background: rgba(9, 14, 17, 232);
  border-bottom: 1px solid #1c292f;
}

QPushButton#NavButton {
  min-height: 44px;
  padding: 8px 12px;
  border: 1px solid transparent;
  border-radius: 8px;
  color: #93a0a5;
  background: transparent;
  text-align: left;
}

QPushButton#NavButton:hover, QPushButton#NavButton:checked {
  color: #12d69a;
  border-color: rgba(18, 214, 154, 70);
  background: #0b2922;
}

QPushButton#PrimaryButton {
  min-height: 44px;
  padding: 9px 18px;
  border: 1px solid #18e0aa;
  border-radius: 9px;
  background: qlineargradient(
    x1: 0, y1: 0, x2: 1, y2: 1,
    stop: 0 #12b88c,
    stop: 1 #087458
  );
  color: #f4fffb;
  font-weight: 800;
}

QPushButton#PrimaryButton:hover {
  border-color: #5ff0ca;
  background: qlineargradient(
    x1: 0, y1: 0, x2: 1, y2: 1,
    stop: 0 #18c99a,
    stop: 1 #09906c
  );
}

QPushButton#PrimaryButton:pressed {
  background: #076b53;
}

QPushButton#SecondaryButton {
  min-height: 42px;
  padding: 9px 16px;
  border: 1px solid #42535a;
  border-radius: 8px;
  background: #162227;
  color: #d1ddda;
  font-weight: 800;
}

QPushButton#SecondaryButton:hover {
  border-color: #6c7f86;
  background: #1b2a30;
  color: #f1f8f6;
}

QPushButton#DangerButton {
  min-height: 42px;
  padding: 9px 16px;
  border: 1px solid #a64a51;
  border-radius: 8px;
  background: #3a171b;
  color: #ffb5ba;
  font-weight: 800;
}

QPushButton#DangerButton:hover {
  border-color: #e36a73;
  background: #551f25;
  color: #ffe4e6;
}

QPushButton#PrimaryButton:disabled,
QPushButton#SecondaryButton:disabled,
QPushButton#DangerButton:disabled {
  border-color: #263238;
  background: #11191d;
  color: #53636a;
}

QFrame#Panel {
  background: #0d1317;
  border: 1px solid #1c292f;
  border-radius: 8px;
}

QLineEdit, QComboBox, QDateTimeEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox {
  min-height: 34px;
  border: 1px solid #29383e;
  border-radius: 7px;
  background: #091013;
  color: #e7efed;
  padding: 5px 9px;
}

QLineEdit:focus, QComboBox:focus, QPlainTextEdit:focus {
  border-color: #16c995;
}

QCheckBox {
  color: #a9b4b1;
  spacing: 8px;
  font-weight: 800;
}

QCheckBox::indicator {
  width: 18px;
  height: 18px;
}

QCheckBox::indicator:unchecked {
  border: 1px solid #3a4b51;
  border-radius: 4px;
  background: #091013;
}

QCheckBox::indicator:checked {
  border: 1px solid #3faeff;
  border-radius: 4px;
  background: #1685f6;
}

QTableWidget {
  gridline-color: #1c292f;
  background: #0b1114;
  alternate-background-color: #10191d;
  color: #dce5e2;
  selection-background-color: #0b2922;
  selection-color: #eef4f2;
  border: 1px solid #1c292f;
  border-radius: 8px;
}

QHeaderView::section {
  background: #111b1f;
  color: #c7d3d0;
  border: 0;
  border-bottom: 1px solid #1c292f;
  padding: 8px;
  font-weight: 800;
}

QGroupBox {
  margin-top: 14px;
  padding-top: 18px;
  color: #12d69a;
  font-weight: 800;
  border: 1px solid #1c292f;
  border-radius: 8px;
  background: #0d1317;
}

QGroupBox::title {
  subcontrol-origin: margin;
  left: 12px;
  padding: 0 5px;
}

QStatusBar {
  background: #080d10;
  color: #829098;
}
